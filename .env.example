# Telegram user API credentials. Get api_id/api_hash at https://my.telegram.org -> API development tools.
# On first run Telethon asks for a login code sent to this phone and stores a local *.session file (gitignored).
TG_API_ID=
TG_API_HASH=
TG_PHONE=

